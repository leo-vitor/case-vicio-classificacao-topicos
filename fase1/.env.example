# Copie para .env e preencha. Nunca suba o .env para o GitHub.
GEMINI_API_KEY=cole_sua_chave_aqui

# Backend do juiz: gemini (real) ou mock (teste sem custo)
JUDGE_BACKEND=gemini
# Um ou mais modelos separados por virgula. Confira o nome atual na documentacao do Gemini.
JUDGE_MODELS=gemini-2.5-flash
RUNS_PER_MODEL=3
TEMPERATURE=0.4
JUDGE_WORKERS=4
# Limita a quantidade de questoes processadas; 0 processa todas.
LIMIT=0

# Candidatos: tfidf (gratis, offline) ou gemini (embeddings)
EMBEDDINGS=tfidf
EMBEDDING_MODEL=gemini-embedding-001
TOP_K=10

# Regra de decisao
THRESH=0.85
LIXEIRA_MIN_Q=40
LIXEIRA_EXTRA=0.05
